{
  "scripts": {
    "test": "mocha",
    "ci-test": "mocha",
    "test:e2e": "node test/e2e/homepage.js",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "dev:ui": "vite",
    "start": "npm run build && wrangler pages dev dist --kv \"img_url\" --r2 \"img_r2\" --port 8080 --binding BASIC_USER=admin --binding BASIC_PASS=123 --persist-to ./data",
    "start:r2": "npm run build && wrangler pages dev dist --kv \"img_url\" --r2 \"img_r2\" --port 8080 --binding BASIC_USER=admin --binding BASIC_PASS=123 --binding STORAGE_PROVIDER=r2 --binding disable_telemetry=true --persist-to ./data",
    "setup": "node scripts/setup-cloudflare.mjs",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "admin:reset": "node scripts/setup-cloudflare.mjs --rotate-admin",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@sentry/tracing": "^7.114.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "mocha": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^7.2.0",
    "wrangler": "^4.120.0"
  }
}
